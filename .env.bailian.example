# ============================================================
# 运营智脑 · 阿里云百炼（Model Studio）配置
# 复制本文件为 .env 即可直接跑真实模型
# ============================================================
# 选型说明（2026-10 实测口径，价格以百炼控制台为准）：
#   大模型 LLM_MODEL      = qwen3.8-max    策略规划 / 报告写作（质量优先）
#   小模型 LLM_SMALL_MODEL = qwen3.8-flash  工具调用 / 抽取 / 路由（成本优先）
#   两者共用同一 base_url 与 api_key，只是模型名不同。
# ------------------------------------------------------------

LLM_PROVIDER=openai_compatible

# ---------- 大模型：qwen3.8-max（Writer / Critic 用）----------
# 2.4T MoE，1M 上下文；12 元/M 输入，36 元/M 输出
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-替换成你的百炼APIKey
LLM_MODEL=qwen3.8-max

# ---------- 小模型：qwen3.8-flash（Planner 路由 / Researcher / 工具参数）----------
# 多模态 MoE，1M 上下文；0.8 元/M 输入，2.7 元/M 输出
# 注意：小模型也必须填 api_key，留空会自动回退到大模型的 key（见 config.py）
LLM_SMALL_MODEL=qwen3.8-flash
LLM_SMALL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_SMALL_API_KEY=sk-替换成你的百炼APIKey

# ---------- 生成参数 ----------
# 百炼 qwen3.8 系列默认开启深度思考，需要稳定的 JSON 输出时温度调低
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ---------- 模型路由 ----------
# 复杂度 < 0.5 走 qwen3.8-flash，>= 0.5 走 qwen3.8-max
# 这是本项目的核心降本机制：让便宜模型承担更多简单子任务。
# 注：具体能降多少成本需受控 A/B 才能给出，本项目未做，故不宣称降幅。
MODEL_ROUTING_THRESHOLD=0.5
ENABLE_COST_TRACKING=true

# ---------- 其余保持默认 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/zhinao.db
MEMORY_WINDOW_SIZE=6
MEMORY_SUMMARY_TRIGGER_TOKENS=3000
MEMORY_TOP_K=3
MAX_REFLECTION_ROUNDS=2
TASK_TOKEN_BUDGET=80000
ENABLE_TRACE=true
TRACE_DIR=./data/traces
