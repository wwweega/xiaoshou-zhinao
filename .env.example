# ============================================================
# 运营智脑 · 跨境电商 Multi-Agent 运营自动化平台
# 从模板复制为 .env 后填写自己的 Key
# ============================================================

# ---------- LLM 配置（OpenAI 兼容接口，可换 DeepSeek / 通义 / 智谱 / 本地 vLLM）----------
# 可选值: openai_compatible | mock
LLM_PROVIDER=openai_compatible

# 大模型（策略/写作，贵但强）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat

# 小模型（抽取/分类/路由，便宜快）—— 用于模型路由降本
LLM_SMALL_MODEL=deepseek-chat
LLM_SMALL_BASE_URL=https://api.deepseek.com/v1
LLM_SMALL_API_KEY=sk-你的key

# 生成参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- 存储 ----------
# 生产用 postgresql+psycopg2://user:pwd@host:5432/db
# 本地无 PG 时自动降级到 SQLite（开箱即跑）
# 说明：本项目默认单机 SQLite + 进程内 LRU 缓存，不依赖 Redis / Celery。
# 早期版本曾预留 REDIS_URL / ENABLE_REDIS，但代码从未引用，已作为死配置删除。
# 若你的部署确实需要共享缓存，请自行引入并接进 app/tools/registry.py 的缓存层。
DATABASE_URL=sqlite:///./data/zhinao.db

# ---------- 记忆 / 上下文工程 ----------
# 短期记忆保留的最近消息条数
MEMORY_WINDOW_SIZE=6
# 超过该 token 数触发摘要压缩
MEMORY_SUMMARY_TRIGGER_TOKENS=3000
# 长期记忆检索返回条数
MEMORY_TOP_K=3

# ---------- 模型路由 ----------
# 任务复杂度低于该阈值走小模型（0-1）
MODEL_ROUTING_THRESHOLD=0.5
# 开启后记录每次调用的 token 与成本
ENABLE_COST_TRACKING=true

# ---------- Agent 行为 ----------
# Critic 打回重跑的最大轮数（防止无限循环烧钱）
MAX_REFLECTION_ROUNDS=2
# 单任务总 token 预算上限，超过则降级为小模型并告警
TASK_TOKEN_BUDGET=80000

# ---------- 可观测 ----------
ENABLE_TRACE=true
TRACE_DIR=./data/traces
